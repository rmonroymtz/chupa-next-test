# Server-side environment. Validated with zod on first use (src/shared/config/env.ts).
# Empty values are treated as unset.

# Required. Magento GraphQL endpoint.
MAGENTO_GRAPHQL_URL=https://magento.example.com/graphql
# Required. Public origin of the storefront, used for canonical URLs and SEO tags. No trailing slash.
PUBLIC_BASE_URL=https://chupaprecios.com.mx
# Required. Base URL of the internal scraper API (CHAPI).
CHAPI_BASE_URL=https://chapi.example.com

# Per-request timeouts in milliseconds (positive integers).
MAGENTO_TIMEOUT_MS=5000
CHAPI_TIMEOUT_MS=15000
# Timeout for the background copy mutation; it never blocks the response.
COPY_MUTATION_TIMEOUT_MS=10000

# Bot User-Agent matchers, comma- or newline-separated, case-insensitive.
# Each entry is a substring or a regular-expression source.
# Leave unset to use the built-in list (googlebot, bingbot, yandex, duckduckbot,
# baiduspider, applebot, facebookexternalhit, facebot, twitterbot, whatsapp,
# telegrambot, slackbot, linkedinbot, discordbot, pinterest, embedly, skypeuripreview, ...).
# BOT_USER_AGENTS=googlebot,bingbot,facebookexternalhit

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# CloudWatch namespace for Embedded Metric Format output.
METRICS_NAMESPACE=ChupaStorefront
